# =============================================================================
# Gitignore for AI Smart Attendance System (AttndX)
# Production-Grade Privacy & Security Rules
# =============================================================================

# ─── 1. USER BIOMETRICS & PRIVATE FACE IMAGES (CRITICAL PRIVACY) ───────────
# Captured enrollment face images and crops
data/captures/*
!data/captures/.gitkeep

# Live attendance session snapshots
data/snapshots/*
!data/snapshots/.gitkeep

# Evaluation artifacts
data/eval/*
!data/eval/.gitkeep

# General image & media patterns in data/
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.webp
data/**/*.bmp
*.jpg
*.jpeg
*.png
*.webp
*.bmp

# Exported attendance CSV reports containing student names & records
attendance_*.csv
*.csv

# ─── 2. DATABASES & PERSISTENCE ─────────────────────────────────────────────
# SQLite databases containing student identities, biometric embeddings & records
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal

# ─── 3. MACHINE LEARNING MODELS & WEIGHTS ───────────────────────────────────
# Auto-downloaded / large model weights
*.pt
*.pth
*.onnx
*.tflite
*.bin
*.weights
*.h5
*.engine
data/models/*
!data/models/.gitkeep

# ─── 4. VIRTUAL ENVIRONMENTS & DEPENDENCIES ─────────────────────────────────
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/
*.egg
.eggs/

# ─── 5. PYTHON BYTECODE & CACHES ────────────────────────────────────────────
__pycache__/
**/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ─── 6. STREAMLIT & WEBAPP ARTIFACTS ────────────────────────────────────────
.streamlit/
!.streamlit/config.toml
*.webrtc.log

# ─── 7. ENVIRONMENT VARIABLES & SECRETS ─────────────────────────────────────
.env
.env.*
!.env.example
secrets.toml

# ─── 8. OPERATING SYSTEM & IDE ARTIFACTS ────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
