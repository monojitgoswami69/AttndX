# =============================================================================
# Gitignore for AI Smart Attendance System (AttndX / Gen2)
# Production-Grade Privacy & Security Rules
# =============================================================================

# ─── 1. USER BIOMETRICS & PRIVATE FACE IMAGES (CRITICAL PRIVACY) ───────────
# Gen2 captured enrollment images and crops
gen2/data/captures/*
!gen2/data/captures/.gitkeep

# Gen2 live attendance session snapshots
gen2/data/snapshots/*
!gen2/data/snapshots/.gitkeep

# Gen2 evaluation artifacts
gen2/data/eval/*
!gen2/data/eval/.gitkeep

# Legacy Gen1 face photos and session snapshots
storage/registered_faces/
storage/registered_faces/*
storage/session_snapshots/
storage/session_snapshots/*
storage/*.pkl
storage/*.json
storage/*.csv

# General image & video patterns in data / storage directories
gen2/data/**/*.jpg
gen2/data/**/*.jpeg
gen2/data/**/*.png
gen2/data/**/*.webp
gen2/data/**/*.bmp
storage/**/*.jpg
storage/**/*.jpeg
storage/**/*.png
storage/**/*.webp
storage/**/*.bmp
*.jpg
*.jpeg
*.png
*.webp
*.bmp

# Exported attendance CSV reports containing student names & records
attendance_*.csv
*.csv

# ─── 2. DATABASES & PERSISTENCE ─────────────────────────────────────────────
# SQLite databases containing student identities, biometric embeddings & records
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
gen2/data/*.db
gen2/data/*.db-wal
gen2/data/*.db-shm
gen2/data/*.db-journal

# ─── 3. MACHINE LEARNING MODELS & WEIGHTS ───────────────────────────────────
# Auto-downloaded / large model weights
*.pt
*.pth
*.onnx
*.tflite
*.bin
*.weights
*.h5
*.engine

# Keep directory structures intact via .gitkeep
!models/.gitkeep
!gen2/data/models/.gitkeep
!storage/.gitkeep

# MiniFASNetV2 anti-spoofing model (converted locally, required for base runtime)
!models/MiniFASNetV2.onnx

# ─── 4. VIRTUAL ENVIRONMENTS & DEPENDENCIES ─────────────────────────────────
venv/
.venv/
env/
ENV/
gen2/venv/
gen2/.venv/
gen2/env/
build/
dist/
*.egg-info/
*.egg
.eggs/

# ─── 5. PYTHON BYTECODE & CACHES ────────────────────────────────────────────
__pycache__/
gen2/**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
gen2/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ─── 6. STREAMLIT & WEBAPP ARTIFACTS ────────────────────────────────────────
.streamlit/
!.streamlit/config.toml
*.webrtc.log

# ─── 7. ENVIRONMENT VARIABLES & SECRETS ─────────────────────────────────────
.env
.env.*
!.env.example
secrets.toml

# ─── 8. OPERATING SYSTEM & IDE ARTIFACTS ────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
