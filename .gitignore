# Virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment files
.env
.env.local

# Logs
*.log

# Model weights / binaries (auto-downloaded on first run)
*.pt
*.pth
*.onnx
*.tflite
# Keep the model directory itself, just ignore the binaries inside it
!models/.gitkeep
# MiniFASNetV2 anti-spoofing model is converted locally and committed (1.7MB)
!models/MiniFASNetV2.onnx

# Storage: user data (face DB, attendance records, snapshots, registered faces)
storage/*.pkl
storage/registered_faces/
storage/session_snapshots/

# Generated / captured images
storage/**/*.jpg
storage/**/*.jpeg
storage/**/*.png
